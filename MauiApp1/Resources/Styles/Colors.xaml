<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ============================================================
         BRAND PALETTE — deep blue / soft purple academic dashboard.
         Every key below is reused across Colors/Styles so a page never
         hardcodes a color; change it here and it updates everywhere.
         ============================================================ -->

    <!-- Primary: deep blue used for buttons, focused fields, links. -->
    <Color x:Key="Primary">#2F80ED</Color>
    <Color x:Key="PrimaryDark">#8FB6F5</Color>
    <Color x:Key="PrimaryDarkText">#14213D</Color>

    <!-- Secondary: soft purple accent used for chips, avatars, highlights. -->
    <Color x:Key="Secondary">#EDEBFF</Color>
    <Color x:Key="SecondaryDarkText">#B3ACFF</Color>
    <Color x:Key="Tertiary">#4A3FBF</Color>

    <!-- Header gradient: deep blue → brighter blue, used behind the
         dashboard/login headers so it reads as one deliberate brand band. -->
    <Color x:Key="HeaderGradientStart">#1E5AA5</Color>
    <Color x:Key="HeaderGradientEnd">#2F80ED</Color>

    <!-- Fixed four-color set for tile/stat accents (icon chip). Always used
         in this order so the same action reads as the same color everywhere. -->
    <Color x:Key="AccentBlue">#2F80ED</Color>
    <Color x:Key="AccentPurple">#6C63FF</Color>
    <Color x:Key="AccentGreen">#27AE60</Color>
    <Color x:Key="AccentAmber">#F59E0B</Color>

    <!-- Text: dark gray for primary copy, muted gray for secondary/caption. -->
    <Color x:Key="TextDark">#2D2D2D</Color>
    <Color x:Key="TextMuted">#7A7A7A</Color>

    <!-- Page/app background: light gray-white, not pure white, for the
         soft "dashboard" surface feel. -->
    <Color x:Key="Background">#F5F7FA</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#2D2D2D</Color>
    <Color x:Key="OffBlack">#1B1F2A</Color>

    <Color x:Key="Gray100">#E7EAF0</Color>
    <Color x:Key="Gray200">#D8DEE7</Color>
    <Color x:Key="Gray300">#C2C9D6</Color>
    <Color x:Key="Gray400">#9AA3B2</Color>
    <Color x:Key="Gray500">#7A7A7A</Color>
    <Color x:Key="Gray600">#4A5568</Color>
    <Color x:Key="Gray900">#242A38</Color>
    <Color x:Key="Gray950">#161A24</Color>

    <!-- Success: green, matched to the light palette's alert/status system. -->
    <Color x:Key="Success">#27AE60</Color>
    <Color x:Key="SuccessTint">#E7F8EE</Color>

    <Color x:Key="Danger">#E0334E</Color>
    <Color x:Key="DangerTint">#FCE9EC</Color>

    <!-- Subtle "surface" used for cards/tiles so they read as a distinct
         layer without needing heavy borders or shadows everywhere. -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#232838</Color>

    <!-- Faint accent tint for hover/selected states. -->
    <Color x:Key="PrimaryTint">#E8F1FD</Color>
    <Color x:Key="PrimaryTintDark">#28345C</Color>

    <!-- Soft glow used behind the Login card in dark mode, echoing the
         blue/purple brand without needing an image asset. -->
    <Color x:Key="GlowCore">#6C63FF</Color>
    <Color x:Key="GlowEdge">#1E5AA5</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>

    <!-- One shared header gradient — reused as-is on every dashboard/login
         header card so they all read as the same surface. -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource HeaderGradientStart}" Offset="0.0" />
        <GradientStop Color="{StaticResource HeaderGradientEnd}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Blue → purple gradient used on the primary/solid-fill buttons
         (e.g. Login, Save) per the brand's blue-purple theme. -->
    <LinearGradientBrush x:Key="ButtonGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource HeaderGradientStart}" Offset="0.0" />
        <GradientStop Color="{StaticResource AccentPurple}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmber}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
