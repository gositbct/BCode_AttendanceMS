<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MauiApp1.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:TimeDisplayConverter x:Key="TimeDisplayConverter" />
    <converters:AttendanceStatusTextConverter x:Key="AttendanceStatusTextConverter" />
    <converters:AttendanceStatusColorConverter x:Key="AttendanceStatusColorConverter" />

    <!-- One attendance record: a date block, the time in/out, and a status
         pill (Complete / In Progress). Shared by AttendanceHistory (student's
         own view) and StudentProfile (admin viewing one student) so both
         always show attendance the same way instead of drifting apart. -->
    <DataTemplate x:Key="AttendanceRowTemplate">
        <Border Style="{StaticResource ListRowCard}">
            <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14" Padding="4">

                <!-- Date block: day number over abbreviated month -->
                <VerticalStackLayout Grid.Column="0"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="{Binding Date, StringFormat='{0:dd}'}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Date, StringFormat='{0:MMM}'}"
                           Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Day name + time in/out -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding Date, StringFormat='{0:dddd}'}"
                           FontAttributes="Bold"
                           FontSize="15"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="In " TextColor="{StaticResource Gray500}" FontSize="13" />
                                <Span Text="{Binding TimeIn, Converter={StaticResource TimeDisplayConverter}}" FontSize="13" FontAttributes="Bold" />
                                <Span Text="&#160;&#160;&#160;Out " TextColor="{StaticResource Gray500}" FontSize="13" />
                                <Span Text="{Binding TimeOut, Converter={StaticResource TimeDisplayConverter}}" FontSize="13" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- Status pill -->
                <Border Grid.Column="2"
                        VerticalOptions="Center"
                        Padding="10,5"
                        StrokeThickness="0"
                        BackgroundColor="{Binding TimeOut, Converter={StaticResource AttendanceStatusColorConverter}}"
                        StrokeShape="RoundRectangle 20">
                    <Label Text="{Binding TimeOut, Converter={StaticResource AttendanceStatusTextConverter}}"
                           TextColor="White"
                           FontSize="11"
                           FontAttributes="Bold" />
                </Border>

            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
