<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.Views.StudentPages.SetPassword"
    Title="Set Password">

    <!-- ========================================= -->
    <!-- GRADIENT BACKGROUND -->
    <!-- ========================================= -->

    <ContentPage.Background>
        <LinearGradientBrush
            StartPoint="-1,1"
            EndPoint="1,0">

            <GradientStop
                Color="Blue"
                Offset="1.5" />

            <GradientStop
                Color="Black"
                Offset="0.5" />

        </LinearGradientBrush>
    </ContentPage.Background>


    <!-- ========================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================= -->

    <ScrollView>

        <VerticalStackLayout
            Padding="{OnIdiom Phone=20, Tablet=35, Desktop=45}"
            Spacing="{OnIdiom Phone=18, Tablet=22, Desktop=25}"
            MaximumWidthRequest="600"
            HorizontalOptions="Center">


            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=18, Tablet=22, Desktop=25}">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{OnIdiom Phone=14, Tablet=18, Desktop=20}"
                    VerticalOptions="Center">

                    <!-- LOCK ICON -->

                    <Border
                        Grid.Column="0"
                        WidthRequest="{OnIdiom Phone=70, Tablet=80, Desktop=85}"
                        HeightRequest="{OnIdiom Phone=70, Tablet=80, Desktop=85}"
                        BackgroundColor="#E0F2FE"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="🔒"
                            FontSize="{OnIdiom Phone=30, Tablet=34, Desktop=38}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>


                    <!-- TITLE -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            Text="Set Your Password"
                            FontSize="{OnIdiom Phone=20, Tablet=23, Desktop=25}"
                            FontAttributes="Bold"
                            TextColor="#222222"
                            LineBreakMode="TailTruncation"
                            MaxLines="1" />

                        <Label
                            Text="Secure your account with a new password."
                            FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=14}"
                            TextColor="#777777"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ========================================= -->
            <!-- INFORMATION -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="#E0F2FE"
                Stroke="#BAE6FD"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="{OnIdiom Phone=14, Tablet=16, Desktop=18}">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Text="ℹ️"
                        FontSize="17"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="1"
                        Text="This is your first login. Create a password that you can remember to protect your attendance account."
                        FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=14}"
                        TextColor="#0369A1"
                        LineBreakMode="WordWrap"
                        VerticalOptions="Center" />

                </Grid>

            </Border>


            <!-- ========================================= -->
            <!-- PASSWORD FORM -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=18, Tablet=22, Desktop=24}">

                <VerticalStackLayout
                    Spacing="{OnIdiom Phone=16, Tablet=18, Desktop=20}">


                    <!-- SECTION TITLE -->

                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Password Information"
                            FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Label
                            Text="Enter and confirm your new password."
                            FontSize="12"
                            TextColor="#888888" />

                    </VerticalStackLayout>


                    <!-- ================================= -->
                    <!-- NEW PASSWORD -->
                    <!-- ================================= -->

                    <VerticalStackLayout
                        Spacing="7">

                        <Label
                            Text="New Password"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Border
                            BackgroundColor="#F9FAFB"
                            Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,0"
                            HeightRequest="50"
                            HorizontalOptions="Fill">

                            <Entry
                                Placeholder="Enter new password"
                                IsPassword="True"
                                Text="{Binding NewPassword}"
                                FontSize="14"
                                TextColor="#222222"
                                PlaceholderColor="#999999"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill" />

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================= -->
                    <!-- CONFIRM PASSWORD -->
                    <!-- ================================= -->

                    <VerticalStackLayout
                        Spacing="7">

                        <Label
                            Text="Confirm Password"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Border
                            BackgroundColor="#F9FAFB"
                            Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,0"
                            HeightRequest="50"
                            HorizontalOptions="Fill">

                            <Entry
                                Placeholder="Confirm your password"
                                IsPassword="True"
                                Text="{Binding ConfirmPassword}"
                                FontSize="14"
                                TextColor="#222222"
                                PlaceholderColor="#999999"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill" />

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================= -->
                    <!-- PASSWORD NOTE -->
                    <!-- ================================= -->

                    <Border
                        BackgroundColor="#F0FDF4"
                        Stroke="#BBF7D0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12">

                        <Label
                            Text="Make sure both password fields match before saving."
                            FontSize="12"
                            TextColor="#15803D"
                            LineBreakMode="WordWrap" />

                    </Border>

                </VerticalStackLayout>

            </Border>


            <!-- ========================================= -->
            <!-- SAVE BUTTON -->
            <!-- ========================================= -->

            <Button
                Text="Save Password"
                HeightRequest="{OnIdiom Phone=52, Tablet=54, Desktop=56}"
                CornerRadius="12"
                BackgroundColor="#4F46E5"
                TextColor="White"
                FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                FontAttributes="Bold"
                Command="{Binding SaveCommand}"
                HorizontalOptions="Fill" />


            <!-- ========================================= -->
            <!-- FOOTER -->
            <!-- ========================================= -->

            <Label
                Text="@ NSNP Attendance Monitoring System"
                FontSize="12"
                TextColor="#C7D7F5"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Fill"
                Margin="0,0,0,10" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>