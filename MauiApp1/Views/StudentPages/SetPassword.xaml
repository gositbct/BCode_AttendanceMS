<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.StudentPages.SetPassword"
             Title="SetPassword">

    <ScrollView>
        <!-- Main structure is a Grid with Auto rows so the intro block,
             form card, and submit button each keep a fixed slot. -->
        <Grid RowDefinitions="Auto,Auto,Auto"
              RowSpacing="20"
              Padding="24"
              VerticalOptions="Center"
              MaximumWidthRequest="420"
              HorizontalOptions="Center">

            <VerticalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center">
                <Border Style="{StaticResource AvatarCircle}">
                    <Label Text="🔒" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Text="Set your password"
                       Style="{StaticResource SubHeadline}" />
                <Label Text="This is your first login - choose a password to secure your account."
                       Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="NEW PASSWORD" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Entry Placeholder="New password" IsPassword="True" Text="{Binding NewPassword}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Entry Placeholder="Confirm password" IsPassword="True" Text="{Binding ConfirmPassword}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Grid.Row="2"
                    Text="Save Password"
                    Style="{StaticResource GradientButton}"
                    Command="{Binding SaveCommand}" />

        </Grid>
    </ScrollView>

</ContentPage>
