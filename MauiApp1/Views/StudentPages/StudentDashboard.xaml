<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.Views.StudentPages.StudentDashboard"
    Title="Student Dashboard"
    BackgroundColor="#F7F8FA">

    <ContentPage.Background>
        <LinearGradientBrush
            StartPoint="0,1"
            EndPoint="1,0">

            <GradientStop
                Color="Blue"
                Offset="1.9" />

            <GradientStop
                Color="Black"
                Offset="0.0" />

        </LinearGradientBrush>
    </ContentPage.Background>


    <ScrollView>
        

        <VerticalStackLayout
            Padding="{OnIdiom Phone=16, Tablet=30, Desktop=40}"
            Spacing="{OnIdiom Phone=16, Tablet=20, Desktop=22}"
            MaximumWidthRequest="650"
            HorizontalOptions="Center"
            WidthRequest="{OnIdiom Phone=-1, Tablet=-1, Desktop=620}">
        

            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="#FFFFFF"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=18, Tablet=22, Desktop=24}"
                HorizontalOptions="Fill">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="14"
                    HorizontalOptions="Fill">

                    <!-- ICON -->

                    <Border
                        Grid.Column="0"
                        WidthRequest="54"
                        HeightRequest="54"
                        BackgroundColor="#E0F2FE"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 27"
                        VerticalOptions="Center">

                        <Label
                            Text="🎓"
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <!-- HEADER TEXT -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            Text="Welcome back"
                            FontSize="12"
                            TextColor="#777777" />

                        <Label
                            Text="{Binding Name}"
                            FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=21}"
                            FontAttributes="Bold"
                            TextColor="#222222"
                            LineBreakMode="TailTruncation"
                            MaxLines="1" />

                        <Label
                            Text="Student Dashboard"
                            FontSize="12"
                            TextColor="#0284C7"
                            LineBreakMode="TailTruncation"
                            MaxLines="1" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ========================================= -->
            <!-- ATTENDANCE STATUS -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="{Binding StatusColor}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                Padding="14"
                HorizontalOptions="Fill"
                MinimumHeightRequest="52">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10"
                    HorizontalOptions="Fill">

                    <Label
                        Grid.Column="0"
                        Text="ℹ️"
                        FontSize="17"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding StatusText}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap" />

                </Grid>

            </Border>


            <!-- ========================================= -->
            <!-- QUICK ACTIONS -->
            <!-- ========================================= -->

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="{OnIdiom Phone=10, Tablet=14, Desktop=16}"
                HorizontalOptions="Fill">

                <!-- HISTORY -->

                <Border
                    Grid.Column="0"
                    BackgroundColor="#FFFFFF"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14"
                    MinimumHeightRequest="105"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding AttendanceHistoryNav}" />
                    </Border.GestureRecognizers>

                    <Grid
                        RowDefinitions="Auto,Auto"
                        RowSpacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Border
                            Grid.Row="0"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#E0F2FE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            HorizontalOptions="Center">

                            <Label
                                Text="📅"
                                FontSize="18"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Grid.Row="1"
                            Text="Attendance History"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#333333"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center"
                            LineBreakMode="TailTruncation"
                            MaxLines="1" />

                    </Grid>

                </Border>


                <!-- PROFILE -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="#FFFFFF"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14"
                    MinimumHeightRequest="105"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding MyProfileNav}" />
                    </Border.GestureRecognizers>

                    <Grid
                        RowDefinitions="Auto,Auto"
                        RowSpacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Border
                            Grid.Row="0"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#EDE9FE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            HorizontalOptions="Center">

                            <Label
                                Text="👤"
                                FontSize="18"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Grid.Row="1"
                            Text="My Profile"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#333333"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center" />

                    </Grid>

                </Border>

            </Grid>


            <!-- ========================================= -->
            <!-- MY BARCODE -->
            <!-- ========================================= -->

            <VerticalStackLayout
                Spacing="10"
                IsVisible="{Binding HasBarcodeValue}"
                HorizontalOptions="Fill">

                <Label
                    Text="My Bar Code"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />

                <Border
                    BackgroundColor="#FFFFFF"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="15"
                    HeightRequest="165"
                    HorizontalOptions="Fill">

                    <Image
                        x:Name="BarcodeImage"
                        HeightRequest="125"
                        WidthRequest="{OnIdiom Phone=280, Tablet=320, Desktop=360}"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

                <Label
                    Text="Show this barcode when checking your attendance."
                    FontSize="11"
                    TextColor="#888888"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>


            <!-- ========================================= -->
            <!-- LOGOUT -->
            <!-- ========================================= -->

            <Button
                Text="Log Out"
                HeightRequest="50"
                WidthRequest="{OnIdiom Phone=150, Tablet=170, Desktop=180}"
                CornerRadius="12"
                BackgroundColor="#FEE2E2"
                TextColor="#DC2626"
                FontSize="14"
                FontAttributes="Bold"
                Command="{Binding LogOutNav}"
                HorizontalOptions="Center" />


            <!-- ========================================= -->
            <!-- FOOTER -->
            <!-- ========================================= -->

            <Label
                Text="@ NSNP Attendance Monitoring System"
                FontSize="11"
                TextColor="#999999"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>