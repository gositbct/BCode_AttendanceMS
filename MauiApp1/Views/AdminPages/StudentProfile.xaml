<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.AdminPages.StudentProfile"
             Title="StudentProfile">

    <ScrollView>
        <!-- Main structure is a Grid with Auto rows so each block (back
             button, identity card, barcode, history, delete) keeps its own
             predictable slot. -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="16"
              Padding="24"
              MaximumWidthRequest="480"
              HorizontalOptions="Center">

            <Button Grid.Row="0"
                Text="&#8592; Back to Masterlist"
                Command="{Binding BackToMasterlistNav}"
                Style="{StaticResource GhostButton}"
                HorizontalOptions="Start" />

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border Style="{StaticResource AvatarCircle}">
                        <Label Text="🎓" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextDark}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Id}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Block}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Label Text="Barcode (reprint)"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}"
                       HorizontalOptions="Center" />
                <Border Style="{StaticResource Card}"
                        Padding="20"
                        HeightRequest="160"
                        HorizontalOptions="Center">
                    <Image x:Name="BarcodeImage"
                           HeightRequest="120"
                           WidthRequest="300"
                           Aspect="AspectFit" />
                </Border>
            </VerticalStackLayout>

            <Label Grid.Row="3"
                   Text="Attendance History"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}" />

            <CollectionView Grid.Row="4"
                             ItemsSource="{Binding AttendanceList}"
                             ItemTemplate="{StaticResource AttendanceRowTemplate}" />

            <Button Grid.Row="5"
                Text="Delete Student"
                Command="{Binding DeleteStudentCommand}"
                Style="{StaticResource DangerButton}" />

        </Grid>
    </ScrollView>

</ContentPage>
