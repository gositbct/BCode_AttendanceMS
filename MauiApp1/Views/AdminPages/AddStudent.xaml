<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.Views.AdminPages.AddStudent"
    Title="Add Account">

    <!-- ========================================= -->
    <!-- BACKGROUND -->
    <!-- ========================================= -->

    <ContentPage.Background>
        <LinearGradientBrush
            StartPoint="-1,1"
            EndPoint="1,0">

            <GradientStop
                Color="Blue"
                Offset="1.5" />

            <GradientStop
                Color="Black"
                Offset="0.5" />

        </LinearGradientBrush>
    </ContentPage.Background>


    <!-- ========================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================= -->

    <ScrollView>

        <VerticalStackLayout
            Padding="{OnIdiom Phone=20, Tablet=35, Desktop=45}"
            Spacing="{OnIdiom Phone=18, Tablet=22, Desktop=25}"
            MaximumWidthRequest="650"
            HorizontalOptions="Center">


            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=18, Tablet=22, Desktop=25}">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="15">

                    <!-- NSNP LOGO -->

                    <Border
                        Grid.Column="0"
                        WidthRequest="80"
                        HeightRequest="80"
                        StrokeThickness="0"
                        BackgroundColor="#E0F2FE"
                        StrokeShape="RoundRectangle 30"
                        HorizontalOptions="Center">

                        <Label
                            Text="▣"
                            FontSize="58"
                            TextColor="#0284C7"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>


                    <!-- TITLE -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            Text="Add New Account"
                            FontSize="{OnIdiom Phone=21, Tablet=23, Desktop=25}"
                            FontAttributes="Bold"
                            TextColor="#222222" />

                        <Label
                            Text="Create a student or administrator account"
                            FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=14}"
                            TextColor="#777777" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ========================================= -->
            <!-- ACCOUNT TYPE -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=18, Tablet=22, Desktop=24}">

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        Text="Account Type"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Label
                        Text="Choose the type of account you want to create."
                        FontSize="12"
                        TextColor="#888888" />


                    <!-- STUDENT / ADMIN -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">


                        <!-- STUDENT -->

                        <Border
                            Grid.Column="0"
                            BackgroundColor="#E0F2FE"
                            Stroke="#0284C7"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="5">

                            <RadioButton
                                Content="Student"
                                GroupName="AccountType"
                                IsChecked="{Binding IsStudentRole}"
                                TextColor="#333333"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <!-- ADMIN -->

                        <Border
                            Grid.Column="1"
                            BackgroundColor="#F9FAFB"
                            Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="5">

                            <RadioButton
                                Content="Admin"
                                GroupName="AccountType"
                                IsChecked="{Binding IsAdminRole}"
                                TextColor="#333333"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- ========================================= -->
            <!-- ACCOUNT INFORMATION -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=18, Tablet=22, Desktop=24}">

                <VerticalStackLayout
                    Spacing="18">


                    <!-- SECTION TITLE -->

                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Account Information"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Label
                            Text="Enter the required information below."
                            FontSize="12"
                            TextColor="#888888" />

                    </VerticalStackLayout>


                    <!-- ================================= -->
                    <!-- FULL NAME -->
                    <!-- ================================= -->

                    <VerticalStackLayout
                        Spacing="7">

                        <Label
                            Text="Full Name"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Border
                            BackgroundColor="#F9FAFB"
                            Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,0"
                            HeightRequest="50">

                            <Entry
                                Placeholder="Enter full name"
                                Text="{Binding Name}"
                                FontSize="14"
                                TextColor="#222222"
                                PlaceholderColor="#999999"
                                VerticalOptions="Center" />

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================= -->
                    <!-- AGE + SEX -->
                    <!-- STUDENT ONLY -->
                    <!-- ================================= -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12"
                        IsVisible="{Binding IsStudentRole}">


                        <!-- AGE -->

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="7">

                            <Label
                                Text="Age"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#333333" />

                            <Border
                                BackgroundColor="#F9FAFB"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="50"
                                Padding="10,0">

                                <Entry
                                    Placeholder="Age"
                                    Keyboard="Numeric"
                                    Text="{Binding Age}"
                                    FontSize="14"
                                    TextColor="#222222"
                                    PlaceholderColor="#999999"
                                    VerticalOptions="Center" />

                            </Border>

                        </VerticalStackLayout>


                        <!-- ================================= -->
                        <!-- SEX PICKER -->
                        <!-- ================================= -->

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="7">

                            <Label
                                Text="Sex"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#333333" />

                            <Border
                                BackgroundColor="#F9FAFB"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="50"
                                Padding="0">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    Padding="10,0"
                                    VerticalOptions="Fill">

                                    <Picker
                                        Grid.Column="0"                                   
                                        SelectedItem="{Binding Sex}"
                                        FontSize="14"
                                        TextColor="#222222"
                                        TitleColor="#999999"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center">

                                        <Picker.Items>

                                            <x:String>Male</x:String>
                                            <x:String>Female</x:String>

                                        </Picker.Items>

                                    </Picker>

                                    <!-- Dropdown indicator -->

                                    <Label
                                        Grid.Column="1"                     
                                        FontSize="18"
                                        TextColor="#777777"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End"
                                        InputTransparent="True" />

                                </Grid>

                            </Border>

                        </VerticalStackLayout>

                    </Grid>


                    <!-- ================================= -->
                    <!-- BLOCK / SECTION -->
                    <!-- STUDENT ONLY -->
                    <!-- ================================= -->

                    <VerticalStackLayout
                        Spacing="7"
                        IsVisible="{Binding IsStudentRole}">

                        <Label
                            Text="Block / Section"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Border
                            BackgroundColor="#F9FAFB"
                            Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,0"
                            HeightRequest="50">

                            <Entry
                                Placeholder="Enter block or section"
                                Text="{Binding Block}"
                                FontSize="14"
                                TextColor="#222222"
                                PlaceholderColor="#999999"
                                VerticalOptions="Center" />

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================= -->
                    <!-- ADMIN INFORMATION -->
                    <!-- ================================= -->

                    <Border
                        BackgroundColor="#F0F9FF"
                        Stroke="#BAE6FD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12"
                        IsVisible="{Binding IsAdminRole}">

                        <Label
                            Text="Admin accounts only require a name. A unique username and login will be generated automatically."
                            FontSize="12"
                            TextColor="#0369A1"
                            LineBreakMode="WordWrap" />

                    </Border>


                    <!-- ================================= -->
                    <!-- STUDENT INFORMATION -->
                    <!-- ================================= -->

                    <Border
                        BackgroundColor="#F0FDF4"
                        Stroke="#BBF7D0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12"
                        IsVisible="{Binding IsStudentRole}">

                        <Label
                            Text="Student ID, username, and barcode will be generated automatically when the account is saved."
                            FontSize="12"
                            TextColor="#15803D"
                            LineBreakMode="WordWrap" />

                    </Border>

                </VerticalStackLayout>

            </Border>


            <!-- ========================================= -->
            <!-- SAVE ACCOUNT -->
            <!-- ========================================= -->

            <Button
                Text="Save Account"
                HeightRequest="52"
                CornerRadius="12"
                BackgroundColor="#4F46E5"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                Command="{Binding SaveCommand}"
                HorizontalOptions="Fill" />


            <!-- ========================================= -->
            <!-- GENERATED ACCOUNT -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#BBF7D0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20"
                IsVisible="{Binding HasGeneratedId}">

                <VerticalStackLayout
                    Spacing="12"
                    HorizontalOptions="Center">


                    <Label
                        Text="✓ Account Created"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#15803D"
                        HorizontalTextAlignment="Center" />


                    <Label
                        Text="{Binding GeneratedId, StringFormat='ID / Username: {0}'}"
                        FontSize="13"
                        TextColor="#555555"
                        HorizontalTextAlignment="Center" />


                    <!-- BARCODE -->

                    <Border
                        IsVisible="{Binding ShowBarcode}"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="8"
                        HeightRequest="130"
                        HorizontalOptions="Center">

                        <Image
                            x:Name="BarcodeImage"
                            HeightRequest="110"
                            WidthRequest="280"
                            Aspect="AspectFit" />

                    </Border>

                </VerticalStackLayout>

            </Border>


            <!-- ========================================= -->
            <!-- BACK BUTTON -->
            <!-- ========================================= -->

            <Button
                Text="← Back to Dashboard"
                HeightRequest="50"
                CornerRadius="12"
                BackgroundColor="White"
                BorderColor="#D1D5DB"
                BorderWidth="1"
                TextColor="#333333"
                FontSize="14"
                FontAttributes="Bold"
                Command="{Binding DashboardNav}"
                HorizontalOptions="Fill" />


            <!-- ========================================= -->
            <!-- FOOTER -->
            <!-- ========================================= -->

            <Label
                Text="@ NSNP Attendance Monitoring System"
                FontSize="12"
                TextColor="#C7D7F5"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>