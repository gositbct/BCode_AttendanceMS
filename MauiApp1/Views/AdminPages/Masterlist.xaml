<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MauiApp1.Converters"
    x:Class="MauiApp1.Views.AdminPages.Masterlist"
    Title="Master List">

    <!-- ========================================= -->
    <!-- BACKGROUND -->
    <!-- ========================================= -->

    <ContentPage.Background>
        <LinearGradientBrush
            StartPoint="-1,1"
            EndPoint="1,0">

            <GradientStop
                Color="Blue"
                Offset="1.5" />

            <GradientStop
                Color="Black"
                Offset="0.5" />

        </LinearGradientBrush>
    </ContentPage.Background>


    <!-- ========================================= -->
    <!-- RESOURCES -->
    <!-- ========================================= -->

    <ContentPage.Resources>
        <converters:InitialsConverter
            x:Key="InitialsConverter" />
    </ContentPage.Resources>


    <!-- ========================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================= -->

    <ScrollView>

        <VerticalStackLayout
            Padding="{OnIdiom Phone=20, Tablet=35, Desktop=45}"
            Spacing="{OnIdiom Phone=18, Tablet=22, Desktop=25}"
            MaximumWidthRequest="650"
            HorizontalOptions="Center">


            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=18, Tablet=22, Desktop=25}">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="15">


                    <!-- NSNP LOGO -->

                    <Border
                        Grid.Column="0"
                        WidthRequest="{OnIdiom Phone=65, Tablet=75, Desktop=80}"
                        HeightRequest="{OnIdiom Phone=65, Tablet=75, Desktop=80}"
                        StrokeThickness="0"
                        BackgroundColor="#E0F2FE"
                        StrokeShape="RoundRectangle 24"
                        HorizontalOptions="Center">

                        <Label
                            Text="▣"
                            FontSize="{OnIdiom Phone=42, Tablet=50, Desktop=55}"
                            TextColor="#0284C7"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>


                    <!-- TITLE -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            Text="Student Master List"
                            FontSize="{OnIdiom Phone=21, Tablet=23, Desktop=25}"
                            FontAttributes="Bold"
                            TextColor="#222222" />

                        <Label
                            Text="{Binding Students.Count, StringFormat='{0} student(s) registered'}"
                            FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=14}"
                            TextColor="#777777"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ========================================= -->
            <!-- SEARCH -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=15, Tablet=18, Desktop=20}">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="Search Students"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Label
                        Text="Search by student name or ID."
                        FontSize="12"
                        TextColor="#888888" />

                    <Border
                        BackgroundColor="#F9FAFB"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="5,0"
                        HeightRequest="50">

                        <SearchBar
                            Placeholder="Search name or ID"
                            Text="{Binding SearchText}"
                            FontSize="14"
                            TextColor="#222222"
                            PlaceholderColor="#999999"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center" />

                    </Border>

                </VerticalStackLayout>

            </Border>


            <!-- ========================================= -->
            <!-- STUDENT LIST -->
            <!-- ========================================= -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="{OnIdiom Phone=15, Tablet=20, Desktop=22}">

                <VerticalStackLayout
                    Spacing="12">


                    <!-- LIST HEADER -->

                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Registered Students"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#333333" />

                        <Label
                            Text="Select a student to view their information."
                            FontSize="12"
                            TextColor="#888888" />

                    </VerticalStackLayout>


                    <!-- ================================= -->
                    <!-- COLLECTION -->
                    <!-- ================================= -->

                    <CollectionView
                        x:Name="studentsCollectionView"
                        ItemsSource="{Binding Students}"
                        SelectionMode="Single"
                        SelectionChanged="OnStudentSelected">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Vertical"
                                ItemSpacing="10" />
                        </CollectionView.ItemsLayout>


                        <!-- EMPTY VIEW -->

                        <CollectionView.EmptyView>

                            <VerticalStackLayout
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Spacing="6"
                                Padding="10,35">

                                <Border
                                    WidthRequest="55"
                                    HeightRequest="55"
                                    BackgroundColor="#E0F2FE"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="?"
                                        FontSize="28"
                                        FontAttributes="Bold"
                                        TextColor="#0284C7"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />

                                </Border>

                                <Label
                                    Text="No students found"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#333333"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Try a different name or ID, or add a new student."
                                    FontSize="12"
                                    TextColor="#888888"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap" />

                            </VerticalStackLayout>

                        </CollectionView.EmptyView>


                        <!-- ================================= -->
                        <!-- STUDENT ITEM -->
                        <!-- ================================= -->

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    BackgroundColor="#F9FAFB"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="{OnIdiom Phone=12, Tablet=14, Desktop=16}">

                                    <Grid
                                        ColumnDefinitions="48,*,Auto"
                                        ColumnSpacing="12">


                                        <!-- ================================= -->
                                        <!-- INITIALS -->
                                        <!-- ================================= -->

                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeThickness="0"
                                            BackgroundColor="#E0F2FE"
                                            StrokeShape="RoundRectangle 23"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="#0284C7"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />

                                        </Border>


                                        <!-- ================================= -->
                                        <!-- STUDENT INFORMATION -->
                                        <!-- ================================= -->

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Name}"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="#222222"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />

                                            <Label
                                                Text="{Binding Id}"
                                                FontSize="12"
                                                TextColor="#777777"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />

                                            <Label
                                                Text="{Binding Block}"
                                                FontSize="12"
                                                TextColor="#777777"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />

                                        </VerticalStackLayout>


                                        <!-- ================================= -->
                                        <!-- SELECT INDICATOR -->
                                        <!-- ================================= -->

                                        <Border
                                            Grid.Column="2"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            BackgroundColor="#E0F2FE"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="›"
                                                FontSize="22"
                                                TextColor="#0284C7"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />

                                        </Border>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </Border>


            <!-- ========================================= -->
            <!-- BACK BUTTON -->
            <!-- ========================================= -->

            <Button
                Text="← Back to Dashboard"
                HeightRequest="50"
                CornerRadius="12"
                BackgroundColor="#4F46E5"
                BorderColor="#4F46E5"
                BorderWidth="1"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                Command="{Binding DashboardNav}"
                HorizontalOptions="Fill" />


            <!-- ========================================= -->
            <!-- FOOTER -->
            <!-- ========================================= -->

            <Label
                Text="@ NSNP Attendance Monitoring System"
                FontSize="12"
                TextColor="#C7D7F5"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Fill"
                Margin="0,5,0,5" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>